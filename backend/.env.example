# SolarSentinel AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ───────── General ─────────────────────────────────────────────────────────
PROJECT_NAME="SolarSentinel AI"
ENVIRONMENT=production          # development | production
DEBUG=False
VERSION=1.0.0

# ───────── API Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ───────── MongoDB ─────────────────────────────────────────────────────────
# Local:
# MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas (recommended for production):
# MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=solar_sentinel
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_SECONDS=10

# ───────── ML Configuration ────────────────────────────────────────────────
MODEL_TYPE=LIGHTGBM
ACTIVE_MODEL_VERSION=v1

# ───────── Physics Thresholds ──────────────────────────────────────────────
SOLEXS_THRESHOLD=25.5

# ───────── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Leave blank to allow all origins (local dev only).
# ALLOWED_ORIGINS=https://solarsentinel.vercel.app
ALLOWED_ORIGINS=
